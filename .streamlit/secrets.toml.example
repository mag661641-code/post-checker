# Пример файла секретов. Скопируйте в .streamlit/secrets.toml и впишите ключи.
# Файл secrets.toml не попадает в git (см. .gitignore).

# Пароль для входа в сервис.
# Если задан — при открытии приложения будет запрашиваться пароль (на всех
# страницах). Если оставить пустым или убрать — вход свободный.
# Это позволяет держать приложение публичным на Streamlit Cloud, но закрытым
# паролем. В облаке этот блок вставляют в «Advanced settings → Secrets».
[auth]
password = "придумайте_пароль"

# Ссылка на отдельную Google-таблицу «Настройки проверки постов» (необязательно,
# но рекомендуется). В неё сохраняются бренды, словари, скрытые замечания и
# ссылка на реестр, чтобы они не пропадали при перезапуске приложения.
# Сервисному аккаунту нужен доступ «Редактор» к этой таблице.
# settings_sheet_url = "https://docs.google.com/spreadsheets/d/…"

# Сервисный аккаунт Google (необязательно) — для чтения реестра прямо из
# Google-таблицы. Таблицу нужно открыть этому аккаунту хотя бы на «Чтение».
#
# САМЫЙ ПРОСТОЙ СПОСОБ (рекомендуется): вставьте ВЕСЬ скачанный JSON-файл-ключ
# целиком между тройными кавычками '''…''' — ничего переделывать не нужно.
# gcp_service_account_json = '''
# {
#   "type": "service_account",
#   "project_id": "ваш-проект",
#   "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
#   "client_email": "имя@ваш-проект.iam.gserviceaccount.com",
#   ... остальные поля из файла ...
# }
# '''
#
# АЛЬТЕРНАТИВА (TOML-таблица): каждое поле отдельной строкой.
# [gcp_service_account]
# type = "service_account"
# project_id = "ваш-проект"
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "имя@ваш-проект.iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "..."
# universe_domain = "googleapis.com"

# Сервисный ключ доступа ВКонтакте (необязательно).
# Нужен только для сверки текста постов ВКонтакте через официальный API.
# Без него сервис только проверяет, что страница ВКонтакте открывается.
[vk]
service_key = ""
